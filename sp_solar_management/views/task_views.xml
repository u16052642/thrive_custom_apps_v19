<?xml version="1.0" encoding="UTF-8"?>
<thrive>
    <!-- Project Task Form Inherit -->
    <record id="view_project_task_form_inherit_solar" model="ir.ui.view">
        <field name="name">project.task.form.inherit.solar</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='milestone_id']" position="after">
                <field name="lead_id" invisible="1"/>
                <field name="installation_id" invisible="1"/>
                <field name="site_inspection_id" invisible="1"/>
                <field name="team_type" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='allocated_hours']" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="widget">float_time</attribute>
            </xpath>
            <xpath expr="//field[@name='allocated_hours']" position="before">
                <label for="allocated_hours"/>
            </xpath>
            <xpath expr="//page[@name='description_page']" position="before">
                <page name="solar_site_information_page" string="Site Information" invisible="not site_inspection_id">
                    <group string="Customer Details" col="2">
                        <group>
                            <field name="site_customer_id" readonly="1"/>
                            <field name="site_customer_phone" readonly="1"/>
                            <field name="site_customer_email" readonly="1"/>
                        </group>
                        <group>
                            <label for="site_street" string="Site Address"/>
                            <div class="o_address_format">
                                <field name="site_street" class="o_address_street" readonly="1"/>
                                <field name="site_street2" class="o_address_street" readonly="1"/>
                                <field name="site_city" class="o_address_city" readonly="1"/>
                                <field name="site_zip" class="o_address_zip" readonly="1"/>
                                <field name="site_state_id" class="o_address_state" readonly="1"/>
                                <field name="site_country_id" class="o_address_country" readonly="1"/>
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_project_task_search_inherit_solar" model="ir.ui.view">
        <field name="name">project.task.search.inherit.solar</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="filter_solar_survey" string="Survey Tasks" domain="[('team_type', '=', 'survey')]"/>
                <filter name="filter_solar_installation" string="Installation Tasks" domain="[('team_type', '=', 'installation')]"/>
                <filter name="filter_solar_qa" string="QA Tasks" domain="[('team_type', '=', 'qa')]"/>
            </xpath>
        </field>
    </record>

    <record id="action_solar_survey_tasks" model="ir.actions.act_window">
        <field name="name">Survey Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="domain">[('team_type', '=', 'survey')]</field>
        <field name="context">{'default_team_type': 'survey'}</field>
    </record>

    <record id="action_solar_installation_tasks" model="ir.actions.act_window">
        <field name="name">Installation Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="domain">[('team_type', '=', 'installation')]</field>
        <field name="context">{'default_team_type': 'installation'}</field>
    </record>

    <record id="action_solar_qa_tasks" model="ir.actions.act_window">
        <field name="name">QA Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="domain">[('team_type', '=', 'qa')]</field>
        <field name="context">{'default_team_type': 'qa'}</field>
    </record>

    <!-- Override Project Window Action to default to list view first, then kanban -->
    <record id="project.open_view_project_all" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="project.view_project"/>
    </record>
</thrive>
