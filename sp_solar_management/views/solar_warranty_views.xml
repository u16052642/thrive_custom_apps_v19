<?xml version="1.0" encoding="UTF-8"?>
<thrive>

    <!-- Warranty Sequence -->
    <record id="seq_solar_warranty_claim" model="ir.sequence">
        <field name="name">Solar Warranty</field>
        <field name="code">solar.warranty.claim</field>
        <field name="prefix">WR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- List View -->
    <record id="view_solar_warranty_claim_list" model="ir.ui.view">
        <field name="name">solar.warranty.claim.list</field>
        <field name="model">solar.warranty.claim</field>
        <field name="arch" type="xml">
            <list string="Warranties"
                  decoration-success="state == 'active'"
                  decoration-danger="state == 'expired'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="installation_id"/>
                <field name="product_id"/>
                <field name="warranty_type"/>
                <field name="start_date"/>
                <field name="expiry_date"/>
                <field name="days_left"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'expired'"
                       decoration-warning="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_solar_warranty_claim_form" model="ir.ui.view">
        <field name="name">solar.warranty.claim.form</field>
        <field name="model">solar.warranty.claim</field>
        <field name="arch" type="xml">
            <form string="Warranty">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_expire" string="Mark as Expired" type="object"
                            class="btn-danger" invisible="state != 'active'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('active', 'expired')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <!-- Left Group -->
                        <group string="General Information">
                            <field name="partner_id"/>
                            <field name="project_id"/>
                            <field name="installation_id"/>
                            <field name="product_id"/>
                            <field name="serial_number"/>
                            <field name="warranty_type"/>
                        </group>
                        <!-- Right Group -->
                        <group string="Warranty Period">
                            <field name="start_date"/>
                            <field name="expiry_date"/>
                            <field name="days_left" widget="integer"
                                   decoration-danger="days_left &lt; 0"
                                   decoration-warning="days_left &lt;= 30 and days_left &gt;= 0"/>  
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Add notes here..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_solar_warranty_claim_search" model="ir.ui.view">
        <field name="name">solar.warranty.claim.search</field>
        <field name="model">solar.warranty.claim</field>
        <field name="arch" type="xml">
            <search string="Warranties">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="installation_id"/>
                <field name="product_id"/>
                <field name="serial_number"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="active" string="Active" domain="[('state','=','active')]"/>
                <filter name="expired" string="Expired" domain="[('state','=','expired')]"/>
                <separator/>
                <filter name="expiring_soon" string="Expiring in 30 days"
                        domain="[('expiry_date','&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d')),('state','=','active')]"/>
                <separator/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_type" string="Warranty Type" context="{'group_by': 'warranty_type'}"/>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_solar_warranty_claim" model="ir.actions.act_window">
        <field name="name">Warranties</field>
        <field name="res_model">solar.warranty.claim</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_solar_warranty_claim_search"/>
    </record>
</thrive>
