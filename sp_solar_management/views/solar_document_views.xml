<?xml version="1.0" encoding="UTF-8"?>
<thrive>
    <record id="view_solar_document_config_list" model="ir.ui.view">
        <field name="name">solar.document.config.list</field>
        <field name="model">solar.document.config</field>
        <field name="arch" type="xml">
            <list string="Document Configuration">
                <field name="name"/>
                <field name="is_required"/>
            </list>
        </field>
    </record>

    <record id="view_solar_document_config_form" model="ir.ui.view">
        <field name="name">solar.document.config.form</field>
        <field name="model">solar.document.config</field>
        <field name="arch" type="xml">
            <form string="Document Configuration">
                <sheet>
                    <group col="2">
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="is_required"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_solar_document_config" model="ir.actions.act_window">
        <field name="name">Document Configuration</field>
        <field name="res_model">solar.document.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_solar_document_config"
              name="SSEG Document Configuration"
              parent="menu_solar_energy_configuration"
              action="action_solar_document_config"
              sequence="30"/>


</thrive>
