<?xml version="1.0" encoding="UTF-8"?>
<thrive>

    <!-- ============ DOCUMENT TYPE CONFIGURATION ============ -->

    <record id="view_solar_document_type_list" model="ir.ui.view">
        <field name="name">solar.document.type.list</field>
        <field name="model">solar.document.type</field>
        <field name="arch" type="xml">
            <list string="Document Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_solar_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">solar.document.type</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ============ DOCUMENTS ============ -->

    <!-- List View -->
    <record id="view_solar_installation_document_list" model="ir.ui.view">
        <field name="name">solar.installation.document.list</field>
        <field name="model">solar.installation.document</field>
        <field name="arch" type="xml">
            <list string="Documents"
                  decoration-danger="is_expired == True"
                  decoration-warning="days_to_expiry &lt;= 30 and days_to_expiry &gt;= 0 and is_expired == False">
                <field name="name"/>
                <field name="installation_id"/>
                <field name="document_type_id"/>
                <field name="document_number"/>
                <field name="issued_by"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry"/>
                <field name="is_expired" widget="boolean" string="Expired"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_solar_installation_document_form" model="ir.ui.view">
        <field name="name">solar.installation.document.form</field>
        <field name="model">solar.installation.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <sheet>
                    <group>
                        <!-- Left -->
                        <group>
                            <field name="name" string="Document Name"/>
                            <field name="installation_id"/>
                            <field name="document_type_id"/>
                            <field name="document_number"/>
                            <field name="issued_by"/>
                        </group>
                        <!-- Right -->
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="is_expired" readonly="1"/>
                            <field name="days_to_expiry" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Attachments"/>
                    <field name="attachment_ids" widget="many2many_binary" string=""/>
                    <separator string="Notes"/>
                    <field name="notes" placeholder="Add notes here..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_solar_installation_document_search" model="ir.ui.view">
        <field name="name">solar.installation.document.search</field>
        <field name="model">solar.installation.document</field>
        <field name="arch" type="xml">
            <search string="Documents">
                <field name="name"/>
                <field name="installation_id"/>
                <field name="document_type_id"/>
                <field name="document_number"/>
                <filter name="expired" string="Expired" domain="[('is_expired','=',True)]"/>
                <filter name="valid" string="Valid" domain="[('is_expired','=',False)]"/>
                <filter name="expiring_soon" string="Expiring in 30 days"
                        domain="[('days_to_expiry','&lt;=',30),('is_expired','=',False)]"/>
                <separator/>
                <filter name="group_type" string="Document Type" context="{'group_by': 'document_type_id'}"/>
                <filter name="group_installation" string="Installation" context="{'group_by': 'installation_id'}"/>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_solar_installation_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">solar.installation.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_solar_installation_document_search"/>
    </record>

</thrive>
