<?xml version="1.0" encoding="UTF-8"?>
<thrive>

    <record id="seq_crm_lead_renewable" model="ir.sequence">
        <field name="name">Solar Tracking ID</field>
        <field name="code">crm.lead.renewable</field>
        <field name="prefix">SOL-%(year)s-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="view_crm_lead_form_renewable_energy" model="ir.ui.view">
        <field name="name">crm.lead.form.renewable.energy</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">

           <xpath expr="//div[hasclass('oe_title')]/div[hasclass('d-flex')]" position="replace">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="flex-grow-1">
                        <h1 class="mb-1" invisible="not id">
                            <field name="solar_reference" readonly="1" class="oe_inline"/>
                        </h1>
                        <h1 class="flex-grow-1" invisible="id">
                            <field class="text-break" options="{'line_breaks': False}" widget="text" name="name" placeholder="e.g. Product Pricing"/>
                        </h1>
                        <div class="text-break text-muted fs-4" invisible="not id">
                            <field name="name" class="oe_inline" placeholder="e.g. Product Pricing"/>
                        </div>
                    </div>
                </div>
            </xpath>

            <!-- HEADER BUTTON -->
            <xpath expr="//header/button[1]" position="before">
                <button name="action_send_solar_application_mail"
                        string="Send Mail"
                        type="object"
                        class="btn-primary"
                        invisible="not id or type != 'opportunity'"/>
            </xpath>

            <xpath expr="//header/field[@name='stage_id']" position="attributes">
                <attribute name="invisible">False</attribute>
            </xpath>

            <xpath expr="//header" position="inside">
                <field name="renewable_has_required_documents" invisible="1"/>
                <button name="action_create_site_inspection"
                        string="Create Site Inspection"
                        type="object"
                        class="btn-secondary"
                        groups="sp_solar_management.group_solar_manager"
                        invisible="site_inspection_count &gt; 0 or type != 'opportunity'"/>
            </xpath>

            <!-- SMART BUTTON -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="project_id" invisible="1"/>
                <button class="oe_stat_button"
                        type="object"
                        name="action_view_project"
                        icon="fa-tasks"
                        groups="sp_solar_management.group_solar_manager"
                        invisible="type == 'lead' or project_count == 0">
                    <field name="project_count" widget="statinfo" string="Project"/>
                </button>
                <button class="oe_stat_button"
                        type="object"
                        name="action_view_site_inspections"
                        icon="fa-building-o"
                        groups="sp_solar_management.group_solar_manager"
                        invisible="site_inspection_count == 0">
                    <field name="site_inspection_count" widget="statinfo" string="Inspections"/>
                </button>
                <button class="oe_stat_button"
                        type="object"
                        name="action_view_government_approval"
                        icon="fa-university"
                        invisible="government_approval_count == 0">
                    <field name="government_approval_count" widget="statinfo" string="SSEG Application"/>
                </button>
            </xpath>

            <xpath expr="//button[@name='action_view_site_inspections']" position="after">
                <xpath expr="//button[@name='action_view_sale_quotation']" position="move"/>
            </xpath>

            <xpath expr="//button[@name='action_view_sale_quotation']" position="attributes">
                <attribute name="invisible">type == 'lead' or quotation_count == 0</attribute>
            </xpath>

            <xpath expr="//field[@id='phone_group_lead_info']/ancestor::div[hasclass('o_row')][1]" position="after">
                <label for="renewable_system_template_id"/>
                <div class="o_row">
                    <field name="renewable_system_template_id"/>
                </div>

            </xpath>

            <xpath expr="//group[@name='lead_priority']/field[@name='priority']" position="before">
                <label for="renewable_approx_amount"/>
                <div class="o_row">
                    <field name="renewable_approx_amount"/>
                </div>
                <label for="renewable_max_timeline"/>
                <div class="o_row">
                    <field name="renewable_max_timeline"/>
                </div>
            </xpath>



            <xpath expr="//group[@invisible=&quot;type == 'lead'&quot;]/field[@name='tag_ids']" position="after">
                <label for="solar_stage" string="Project Progress"/>
                <div class="o_row">
                    <field name="solar_stage"
                           widget="badge"
                           readonly="1"
                           class="oe_inline"
                           decoration-danger="solar_stage == 'document_pending'"
                           decoration-warning="solar_stage in ('application_submitted', 'site_survey_scheduled')"
                           decoration-info="solar_stage in ('design_approved', 'government_approval')"
                           decoration-primary="solar_stage in ('installation_in_progress', 'inspection_testing')"
                           decoration-success="solar_stage == 'system_activated'"/>
                </div>
                <label for="renewable_gov_application_number"/>
                <div class="o_row">
                    <field name="renewable_gov_application_number"/>
                </div>
            </xpath>

            <xpath expr="//field[@name='function']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- SOLAR TAB -->
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Solar Requirements" name="solar_requirements">

                    <group col="2">
                        <group>
                            <field name="renewable_service_type"/>
                            <field name="renewable_solar_company_id"/>
                        </group>
                        <group>
                            <field name="renewable_contract_demand_kw"/>
                        </group>
                    </group>

                    <separator string="Electricity Details"/>

                    <group col="2">
                        <group>
                            <field name="renewable_connection_type" widget="radio"/>
                            <field name="renewable_existing_connection"/>
                            <field name="renewable_existing_supply_volts"/>
                        </group>
                        <group>
                            <field name="renewable_consumer_no"/>
                            <field name="renewable_monthly_electric_bill"/>
                            <field name="renewable_monthly_electricity_consumption"/>
                        </group>
                    </group>

                    <separator string="Solar Requirement"/>

                    <group col="2">
                        <group>
                            <field name="renewable_roof_type"/>
                        </group>
                        <group>
                            <field name="renewable_roof_area_sqft"/>
                        </group>
                    </group>

                    <separator string="Site Information"/>

                    <group col="2">
                        <group>
                            <field name="renewable_site_usage"/>
                            <field name="renewable_property_type"/>
                            <field name="renewable_property_age_years"/>
                        </group>

                        <group>
                            <label for="renewable_site_street" string="Address"/>
                            <div class="o_address_format">
                                <field name="renewable_site_street" class="o_address_street" placeholder="Street..."/>
                                <field name="renewable_site_street2" class="o_address_street" placeholder="Street 2..."/>
                                <field name="renewable_site_city" class="o_address_city" placeholder="City"/>
                                <field name="renewable_site_zip" class="o_address_zip" placeholder="ZIP"/>
                                <field name="renewable_site_state_id" class="o_address_state" placeholder="State"/>
                                <field name="renewable_site_country_id" class="o_address_country" placeholder="Country"/>
                            </div>
                        </group>
                    </group>

                    <separator string="Site Location"/>

                    <group col="2">
                        <group>
                            <field name="renewable_site_latitude"/>
                        </group>
                        <group>
                            <field name="renewable_site_longitude"/>
                        </group>
                    </group>

                </page>

                <page string="Documents" name="solar_documents">
                    <separator string="Required Documents"/>
                    <field name="required_solar_document_line_ids" nolabel="1" class="o_solar_document_list">
                        <list editable="bottom" create="false" delete="false">
                            <field name="name" readonly="1" string="Document Name"/>
                            <field name="document_file" widget="binary" filename="document_filename" string="Upload"/>
                            <button name="action_view_document" string="View File" type="object" class="btn btn-secondary btn-sm" invisible="not document_file"/>
                            <field name="document_filename" column_invisible="1"/>
                        </list>
                    </field>

                    <separator string="Optional Documents"/>
                    <field name="optional_solar_document_line_ids" nolabel="1" class="o_solar_document_list">
                        <list editable="bottom" create="false" delete="false">
                            <field name="name" readonly="1" string="Document Name"/>
                            <field name="document_file" widget="binary" filename="document_filename" string="Upload"/>
                            <button name="action_view_document" string="View File" type="object" class="btn btn-secondary btn-sm" invisible="not document_file"/>
                            <field name="document_filename" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>


    <record id="view_crm_lead_tree_renewable" model="ir.ui.view">
        <field name="name">crm.lead.tree.renewable</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="before">
                <field name="solar_reference" string="Solar Reference" optional="show" readonly="1"/>
            </xpath>

        </field>
    </record>

    <record id="view_crm_opportunity_tree_renewable" model="ir.ui.view">
        <field name="name">crm.lead.tree.opportunity.renewable</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="before">
                <field name="solar_reference" string="Solar Reference" optional="show" readonly="1"/>
            </xpath>

        </field>
    </record>

    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view"
               search="[('name', '=', 'crm.lead.form.renewable.energy'), ('id', '!=', ref('sp_solar_management.view_crm_lead_form_renewable_energy'))]"/>
        <value eval="{'active': False}"/>
    </function>

</thrive>
