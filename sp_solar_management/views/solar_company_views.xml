<?xml version="1.0" encoding="UTF-8"?>
<thrive>
    <record id="view_solar_company_tree" model="ir.ui.view">
        <field name="name">solar.company.tree</field>
        <field name="model">solar.company</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_solar_company_form" model="ir.ui.view">
        <field name="name">solar.company.form</field>
        <field name="model">solar.company</field>
        <field name="arch" type="xml">
            <form string="Solar Company">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group></group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_solar_company" model="ir.actions.act_window">
        <field name="name">Solar Companies</field>
        <field name="res_model">solar.company</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_solar_company"
              name="Solar Companies"
              parent="menu_solar_energy_configuration"
              action="action_solar_company"
              sequence="20"/>
</thrive>
