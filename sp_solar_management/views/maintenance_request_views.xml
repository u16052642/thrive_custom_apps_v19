<?xml version="1.0" encoding="utf-8"?>
<thrive>
    <!-- Maintenance Request Form Customization -->
    <record id="hr_equipment_request_view_form_inherit_solar" model="ir.ui.view">
        <field name="name">maintenance.request.form.inherit.solar</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button string="Create Invoice" name="action_create_invoice" type="object" class="oe_highlight" invisible="not is_chargeable or invoice_id or archive"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button class="oe_stat_button" name="action_view_invoice" type="object" icon="fa-pencil-square-o" invisible="not invoice_id">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Invoice</span>
                        </div>
                    </button>
                </div>
            </xpath>
            <xpath expr="//field[@name='maintenance_type']" position="after">
                <field name="invoice_id" invisible="1"/>
                <field name="partner_id"/>
                <field name="project_id" domain="partner_id and [('partner_id', '=', partner_id)] or []"/>
                <field name="installation_id" domain="partner_id and [('partner_id', '=', partner_id)] or []"/>
                <field name="contract_id" domain="partner_id and [('partner_id', '=', partner_id)] or []"/>
                <field name="solar_issue_category_id" options="{'no_create_edit': True}"/>
                <field name="solar_visit_type_id" options="{'no_create_edit': True}"/>
            </xpath>
            <xpath expr="//notebook/page[1]" position="before">
                <page string="Maintenance Cost">
                    <group>
                        <group string="Service Charges">
                            <field name="currency_id" invisible="1"/>
                            <field name="is_chargeable"/>
                            <field name="service_charge" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="transport_charge" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>
                    <field name="part_line_ids" mode="list">
                        <list editable="bottom" string="Parts Cost">
                            <field name="product_id"/>
                            <field name="qty"/>
                            <field name="cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="subtotal" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="parts_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <div class="oe_subtotal_footer_separator oe_inline">
                            <label for="total_cost"/>
                        </div>
                        <field name="total_cost" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </group>
                </page>
                <page string="Service Report">
                    <group>
                        <field name="problem_found" placeholder="Describe the problem found..."/>
                        <field name="root_cause" placeholder="Describe the root cause..."/>
                        <field name="action_taken" placeholder="Describe the action taken..."/>
                    </group>
                </page>
                <page string="Images">
                    <div class="mb-3 mt-2 px-3">
                        <button name="action_open_photo_wizard"
                                string="Add"
                                type="object"
                                class="btn-secondary"/>
                    </div>
                    <field name="image_ids" mode="kanban" class="o_solar_site_images_kanban" nolabel="1">
                        <kanban class="o_kanban_mobile" quick_create="false" create="false" edit="false" delete="false">
                            <field name="image"/>
                            <field name="image_name"/>
                            <field name="image_type"/>
                            <templates>
                                <t t-name="card">
                                    <div class="oe_kanban_global_click p-1">
                                        <div class="fw-bold mb-1">
                                            <field name="image_type"/>
                                        </div>
                                        <div>
                                            <field name="image" widget="image" class="img img-fluid" options="{'size': [260, 180]}"/>
                                        </div>
                                        <div class="text-truncate mt-1" style="max-width: 260px;">
                                            <field name="image_name"/>
                                        </div>
                                        <button name="action_delete" string="Remove" type="object" class="btn btn-danger btn-sm mt-1"/>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Solar Maintenance Issue Category Views -->
    <record id="view_solar_maintenance_issue_category_tree" model="ir.ui.view">
        <field name="name">solar.maintenance.issue.category.list</field>
        <field name="model">solar.maintenance.issue.category</field>
        <field name="arch" type="xml">
            <list string="Issue Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_solar_maintenance_issue_category" model="ir.actions.act_window">
        <field name="name">Issue Categories</field>
        <field name="res_model">solar.maintenance.issue.category</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_solar_maintenance_issue_category"
              name="Issue Categories"
              parent="menu_solar_energy_configuration"
              action="action_solar_maintenance_issue_category"
              groups="sp_solar_management.group_solar_manager"
              sequence="35"/>

    <!-- Solar Maintenance Visit Type Views -->
    <record id="view_solar_maintenance_visit_type_tree" model="ir.ui.view">
        <field name="name">solar.maintenance.visit.type.list</field>
        <field name="model">solar.maintenance.visit.type</field>
        <field name="arch" type="xml">
            <list string="Visit Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_solar_maintenance_visit_type" model="ir.actions.act_window">
        <field name="name">Visit Types</field>
        <field name="res_model">solar.maintenance.visit.type</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_solar_maintenance_visit_type"
              name="Visit Types"
              parent="menu_solar_energy_configuration"
              action="action_solar_maintenance_visit_type"
              groups="sp_solar_management.group_solar_manager"
              sequence="36"/>

    <!-- Maintenance Request Photo Wizard Form View -->
    <record id="view_maintenance_request_photo_wizard_form" model="ir.ui.view">
        <field name="name">maintenance.request.photo.wizard.form</field>
        <field name="model">maintenance.request.photo.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Before/After Photos">
                <sheet>
                    <group>
                        <field name="photo_type" widget="radio" options="{'horizontal': true}"/>
                        <field name="photo_name" invisible="1"/>
                        <field name="photo" filename="photo_name" string="Image"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save" string="Save" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</thrive>
