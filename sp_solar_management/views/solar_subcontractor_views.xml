<?xml version="1.0" encoding="utf-8"?>
<thrive>
    <record id="view_solar_subcontractor_tree" model="ir.ui.view">
        <field name="name">solar.subcontractor.tree</field>
        <field name="model">solar.subcontractor</field>
        <field name="arch" type="xml">
            <list string="Subcontractors">
                <field name="name"/>
                <field name="contact_person"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <record id="view_solar_subcontractor_form" model="ir.ui.view">
        <field name="name">solar.subcontractor.form</field>
        <field name="model">solar.subcontractor</field>
        <field name="arch" type="xml">
            <form string="Subcontractor Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="contact_person"/>
                        </group>
                        <group>
                            <field name="phone"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_solar_subcontractor" model="ir.actions.act_window">
        <field name="name">Subcontractors</field>
        <field name="res_model">solar.subcontractor</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_solar_subcontractor"
              name="Subcontractors"
              parent="menu_solar_energy_configuration"
              action="action_solar_subcontractor"
              sequence="30"/>
</thrive>
