<?xml version="1.0" encoding="UTF-8"?>
<thrive>
    <template id="solar_tracking_status_page" name="Solar Tracking Status Page">
        <t t-call="portal.portal_layout">
            <div class="o_portal_wrap o_solar_dashboard_page py-4 py-lg-5">
                <div class="container">
                    <t t-if="lead">
                        <section class="o_solar_dashboard_hero mb-4">
                            <div class="o_solar_dashboard_hero_main">
                                <div class="o_solar_dashboard_eyebrow">
                                    <i class="fa fa-sun-o me-2" aria-hidden="true"/>
                                    Customer Project Portal
                                </div>
                                <h1 class="o_solar_dashboard_title">Solar Project</h1>
                                <p class="o_solar_dashboard_subtitle mb-0">Track your project progress, approvals, documents, and installation updates in one place.</p>
                            </div>
                            <div class="o_solar_dashboard_status_box">
                                <span class="o_solar_dashboard_status_label">Current Status</span>
                                <span class="o_solar_dashboard_status_badge">
                                    <i class="fa fa-bolt" aria-hidden="true"/>
                                    <t t-out="solar_stage_label"/>
                                </span>
                                <div class="o_solar_dashboard_status_meta">
                                    <span>Project Progress</span>
                                    <strong><t t-out="dashboard_highlights[0]['value']"/></strong>
                                </div>
                            </div>
                        </section>

                        <div class="o_solar_dashboard_stack">
                            <div class="o_solar_dashboard_highlight_grid">
                                <div t-foreach="dashboard_highlights" t-as="item" class="o_solar_dashboard_highlight_card">
                                    <div class="o_solar_dashboard_highlight_icon">
                                        <i t-att-class="'fa %s' % item['icon']" aria-hidden="true"/>
                                    </div>
                                    <div>
                                        <span class="o_solar_dashboard_info_label"><t t-out="item['label']"/></span>
                                        <strong class="o_solar_dashboard_highlight_value"><t t-out="item['value']"/></strong>
                                        <div class="o_solar_dashboard_document_meta"><t t-out="item['detail']"/></div>
                                    </div>
                                </div>
                            </div>
                            <section class="o_solar_dashboard_card">
                                <div class="o_solar_dashboard_card_header">
                                    <div>
                                        <span class="o_solar_dashboard_section_kicker">
                                            <i class="fa fa-user-circle-o me-2" aria-hidden="true"/>
                                            Project Summary
                                        </span>
                                        <h2>Project Summary</h2>
                                    </div>
                                </div>
                                <div class="o_solar_dashboard_info_grid">
                                    <div t-foreach="project_summary" t-as="item"
                                         class="o_solar_dashboard_info_item"
                                         t-att-class="'o_solar_dashboard_info_item %s' % ('is-full' if item.get('full') else '')">
                                        <span class="o_solar_dashboard_info_label"><t t-out="item['label']"/></span>
                                        <strong class="o_solar_dashboard_info_value"><t t-out="item['value']"/></strong>
                                    </div>
                                </div>
                            </section>

                            <section class="o_solar_dashboard_card">
                                <div class="o_solar_dashboard_card_header">
                                    <div>
                                        <span class="o_solar_dashboard_section_kicker">
                                            <i class="fa fa-clock-o me-2" aria-hidden="true"/>
                                            Timeline
                                        </span>
                                        <h2>Project Timeline</h2>
                                    </div>
                                </div>
                                <div class="o_solar_dashboard_timeline">
                                    <div t-foreach="timeline_steps" t-as="step"
                                         class="o_solar_dashboard_timeline_item"
                                         t-att-class="'o_solar_dashboard_timeline_item is-%s' % step['state']">
                                        <div class="o_solar_dashboard_timeline_marker">
                                            <span t-if="step['state'] == 'completed'"><i class="fa fa-check" aria-hidden="true"/></span>
                                            <span t-if="step['state'] == 'current'"><i class="fa fa-bolt" aria-hidden="true"/></span>
                                            <span t-if="step['state'] == 'pending'"><i class="fa fa-circle-thin" aria-hidden="true"/></span>
                                        </div>
                                        <div class="o_solar_dashboard_timeline_content">
                                            <div class="o_solar_dashboard_timeline_title"><t t-out="step['label']"/></div>
                                            <div class="o_solar_dashboard_timeline_state">
                                                <t t-if="step['state'] == 'completed'">Completed</t>
                                                <t t-if="step['state'] == 'current'">Current Step</t>
                                                <t t-if="step['state'] == 'pending'">Pending</t>
                                            </div>
                                            <div class="o_solar_dashboard_timeline_note"><t t-out="step['description']"/></div>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <div class="o_solar_dashboard_grid o_solar_dashboard_grid_two">
                                <section class="o_solar_dashboard_card">
                                    <div class="o_solar_dashboard_card_header">
                                        <div>
                                            <span class="o_solar_dashboard_section_kicker">
                                                <i class="fa fa-cogs me-2" aria-hidden="true"/>
                                                Solar System Details
                                            </span>
                                            <h2>Solar System Details</h2>
                                        </div>
                                    </div>
                                    <div class="o_solar_dashboard_stat_grid">
                                        <div t-foreach="system_details" t-as="detail" class="o_solar_dashboard_stat_item">
                                            <span class="o_solar_dashboard_info_label"><t t-out="detail['label']"/></span>
                                            <strong class="o_solar_dashboard_info_value">
                                                <t t-if="detail.get('value_type') == 'number' and detail.get('value') not in (False, None)">
                                                    <t t-out="detail['value']"/>
                                                    <t t-if="detail.get('suffix')">
                                                        <span class="o_solar_dashboard_muted"> <t t-out="detail['suffix']"/></span>
                                                    </t>
                                                </t>
                                                <t t-if="detail.get('value_type') != 'number'">
                                                    <t t-out="detail.get('value') or '-'"/>
                                                </t>
                                                <t t-if="detail.get('value_type') == 'number' and detail.get('value') in (False, None)">-</t>
                                            </strong>
                                        </div>
                                    </div>
                                </section>

                                <section class="o_solar_dashboard_card">
                                    <div class="o_solar_dashboard_card_header">
                                        <div>
                                            <span class="o_solar_dashboard_section_kicker">
                                                <i class="fa fa-money me-2" aria-hidden="true"/>
                                                Cost &amp; Payment
                                            </span>
                                            <h2>Commercial Summary</h2>
                                        </div>
                                    </div>
                                    <div class="o_solar_dashboard_stat_grid">
                                        <div class="o_solar_dashboard_stat_item">
                                            <span class="o_solar_dashboard_info_label">Total Project Cost</span>
                                            <strong class="o_solar_dashboard_info_value">
                                                <t t-if="cost_details['total_project_cost'] is not False">
                                                    <span t-out="cost_details['total_project_cost']" t-options='{"widget": "monetary", "display_currency": display_currency}'/>
                                                </t>
                                                <t t-else="">-</t>
                                            </strong>
                                        </div>
                                        <div class="o_solar_dashboard_stat_item">
                                            <span class="o_solar_dashboard_info_label">Customer Payable Amount</span>
                                            <strong class="o_solar_dashboard_info_value">
                                                <t t-if="cost_details['customer_payable_amount'] is not False">
                                                    <span t-out="cost_details['customer_payable_amount']" t-options='{"widget": "monetary", "display_currency": display_currency}'/>
                                                </t>
                                                <t t-else="">-</t>
                                            </strong>
                                        </div>
                                        <div class="o_solar_dashboard_stat_item">
                                            <span class="o_solar_dashboard_info_label">Payment Status</span>
                                            <strong class="o_solar_dashboard_payment_badge" t-att-class="'o_solar_dashboard_payment_badge is-%s' % cost_details['payment_status']['state']">
                                                <t t-out="cost_details['payment_status']['label']"/>
                                            </strong>
                                        </div>
                                    </div>
                                </section>
                            </div>

                            <div class="o_solar_dashboard_grid o_solar_dashboard_grid_two">
                                <section class="o_solar_dashboard_card">
                                    <div class="o_solar_dashboard_card_header">
                                        <div>
                                            <span class="o_solar_dashboard_section_kicker">
                                                <i class="fa fa-files-o me-2" aria-hidden="true"/>
                                                Documents
                                            </span>
                                            <h2>Customer Documents</h2>
                                        </div>
                                    </div>
                                    <div class="o_solar_dashboard_document_grid">
                                        <div t-foreach="document_statuses" t-as="document"
                                             class="o_solar_dashboard_document_card"
                                             t-att-class="'o_solar_dashboard_document_card %s' % ('is-done' if document['is_uploaded'] else 'is-pending')">
                                            <div class="o_solar_dashboard_document_head">
                                                <div>
                                                    <h3><t t-out="document['label']"/></h3>
                                                    <div class="o_solar_dashboard_document_meta"><t t-out="document['detail']"/></div>
                                                </div>
                                                <span class="o_solar_dashboard_state_badge"
                                                      t-att-class="'o_solar_dashboard_state_badge %s' % ('is-done' if document['is_uploaded'] else 'is-pending')">
                                                    <t t-out="document['status']"/>
                                                </span>
                                            </div>
                                            <div class="o_solar_dashboard_document_footer">
                                                <span class="o_solar_dashboard_filename"><t t-out="document['filename']"/></span>
                                                <a t-if="document['url']" t-att-href="document['url']" target="_blank" class="btn btn-outline-primary btn-sm">
                                                    <i class="fa fa-eye me-1" aria-hidden="true"/>
                                                    View File
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </section>

                                <section class="o_solar_dashboard_card">
                                    <div class="o_solar_dashboard_card_header">
                                        <div>
                                            <span class="o_solar_dashboard_section_kicker">
                                                <i class="fa fa-wrench me-2" aria-hidden="true"/>
                                                Installation Details
                                            </span>
                                            <h2>Installation Planning</h2>
                                        </div>
                                    </div>
                                    <div class="o_solar_dashboard_stat_grid">
                                        <div class="o_solar_dashboard_stat_item">
                                            <span class="o_solar_dashboard_info_label">Installation Status</span>
                                            <strong class="o_solar_dashboard_info_value"><t t-out="installation_details['status']"/></strong>
                                        </div>
                                        <div class="o_solar_dashboard_stat_item">
                                            <span class="o_solar_dashboard_info_label">Installation Date</span>
                                            <strong class="o_solar_dashboard_info_value"><t t-out="installation_details['date'] or '-'"/></strong>
                                        </div>
                                        <div class="o_solar_dashboard_stat_item">
                                            <span class="o_solar_dashboard_info_label">Assigned Team</span>
                                            <strong class="o_solar_dashboard_info_value"><t t-out="installation_details['assigned_team']"/></strong>
                                        </div>
                                        <div class="o_solar_dashboard_stat_item">
                                            <span class="o_solar_dashboard_info_label">Assigned Engineer</span>
                                            <strong class="o_solar_dashboard_info_value"><t t-out="installation_details['engineer_name']"/></strong>
                                        </div>
                                    </div>
                                </section>
                            </div>

                            <div class="o_solar_dashboard_grid o_solar_dashboard_grid_two">
                                <section class="o_solar_dashboard_card">
                                    <div class="o_solar_dashboard_card_header">
                                        <div>
                                            <span class="o_solar_dashboard_section_kicker">
                                                <i class="fa fa-history me-2" aria-hidden="true"/>
                                                Recent Updates
                                            </span>
                                            <h2>Recent Project Updates</h2>
                                        </div>
                                    </div>
                                    <div class="o_solar_dashboard_updates">
                                        <div t-foreach="recent_updates" t-as="update" class="o_solar_dashboard_update_item">
                                            <div class="o_solar_dashboard_update_date"><t t-out="update['date']"/></div>
                                            <div class="o_solar_dashboard_update_content">
                                                <strong><t t-out="update['title']"/></strong>
                                                <div class="o_solar_dashboard_document_meta"><t t-out="update['detail']"/></div>
                                            </div>
                                        </div>
                                    </div>
                                </section>

                                <section class="o_solar_dashboard_card">
                                    <div class="o_solar_dashboard_card_header">
                                        <div>
                                            <span class="o_solar_dashboard_section_kicker">
                                                <i class="fa fa-stethoscope me-2" aria-hidden="true"/>
                                                Inspection Update
                                            </span>
                                            <h2>Survey &amp; Technical Update</h2>
                                        </div>
                                    </div>
                                    <div class="o_solar_dashboard_stat_grid">
                                        <div class="o_solar_dashboard_stat_item">
                                            <span class="o_solar_dashboard_info_label">Inspection Status</span>
                                            <strong class="o_solar_dashboard_info_value"><t t-out="inspection_details['status']"/></strong>
                                        </div>
                                        <div class="o_solar_dashboard_stat_item">
                                            <span class="o_solar_dashboard_info_label">Inspection Date</span>
                                            <strong class="o_solar_dashboard_info_value"><t t-out="inspection_details['date']"/></strong>
                                        </div>
                                        <div class="o_solar_dashboard_stat_item is-full">
                                            <span class="o_solar_dashboard_info_label">Assigned Engineer / Team Member</span>
                                            <strong class="o_solar_dashboard_info_value"><t t-out="inspection_details['engineer_name']"/></strong>
                                        </div>
                                    </div>
                                </section>
                            </div>

                            <section class="o_solar_dashboard_card">
                                <div class="o_solar_dashboard_card_header">
                                    <div>
                                        <span class="o_solar_dashboard_section_kicker">
                                            <i class="fa fa-headphones me-2" aria-hidden="true"/>
                                            Support Contact
                                        </span>
                                        <h2>Support Contact</h2>
                                    </div>
                                </div>
                                <div class="o_solar_dashboard_support_grid">
                                    <div class="o_solar_dashboard_support_item">
                                        <span class="o_solar_dashboard_info_label">Project Coordinator</span>
                                        <strong><t t-out="support_details['contact_person']"/></strong>
                                    </div>
                                    <div class="o_solar_dashboard_support_item">
                                        <span class="o_solar_dashboard_info_label">Support Phone</span>
                                        <strong><t t-out="support_details['phone']"/></strong>
                                    </div>
                                    <div class="o_solar_dashboard_support_item">
                                        <span class="o_solar_dashboard_info_label">Support Email</span>
                                        <strong><t t-out="support_details['email']"/></strong>
                                    </div>
                                </div>
                            </section>
                        </div>
                    </t>

                    <t t-else="">
                        <div class="row justify-content-center">
                            <div class="col-lg-7">
                                <div class="o_solar_dashboard_card text-center">
                                    <h2 class="mb-3">Solar Project Dashboard</h2>
                                    <div class="alert alert-warning mb-0" role="alert">
                                        Invalid or expired link.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
</thrive>
