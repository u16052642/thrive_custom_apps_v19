<?xml version="1.0" encoding="UTF-8"?>
<thrive>

    <!-- ===================== SURVEY TEAM ===================== -->

    <!-- LIST -->
    <record id="view_solar_survey_team_list" model="ir.ui.view">
        <field name="name">solar.survey.team.list</field>
        <field name="model">solar.survey.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="team_project"/>
                <field name="manager_id"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_solar_survey_team_form" model="ir.ui.view">
        <field name="name">solar.survey.team.form</field>
        <field name="model">solar.survey.team</field>
        <field name="arch" type="xml">
            <form string="Survey Team">
                <sheet>

                    <!-- TITLE -->
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <!-- INFO -->
                    <group>
                        <group>
                            <field name="team_project"/>
                        </group>
                        <group>
                            <field name="manager_id"/>
                            <field name="company_id"/>
                        </group>
                    </group>

                    <!-- MEMBERS -->
                    <notebook>
                        <page string="Team Members">

                            <field name="member_ids"
                                   widget="many2many_kanban"
                                   options="{'no_create': False}">

                                <kanban create="true" quick_create="false">
                                    <control>
                                        <create string="Add"/>
                                    </control>

                                    <templates>

                                        <!-- MEMBER CARD -->
                                        <t t-name="card">
                                            <div class="o_kanban_card d-flex align-items-center mb-2">

                                                <!-- Avatar -->
                                                <div class="o_kanban_image me-2">
                                                    <field name="image_128"
                                                           widget="image"
                                                           class="rounded-circle"
                                                           style="width:40px;height:40px;"/>
                                                </div>

                                                <!-- Info -->
                                                <div>
                                                    <div>
                                                        <strong>
                                                            <field name="name"/>
                                                        </strong>
                                                    </div>
                                                    <div class="text-muted">
                                                        <field name="email"/>
                                                    </div>
                                                </div>

                                            </div>
                                        </t>

                                    </templates>

                                </kanban>

                            </field>

                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_solar_survey_team" model="ir.actions.act_window">
        <field name="name">Survey Teams</field>
        <field name="res_model">solar.survey.team</field>
        <field name="view_mode">list,form</field>
    </record>


